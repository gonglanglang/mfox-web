{
  "name": "萌狐MFoxAI",
  "version": "1.0.0",
  "description": "萌狐MFox AI - 二次元风格的 AI 漫画桌面/浏览器应用",
  "main": "./out/main/index.js",
  "author": "萌狐MFox AI",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:browser": "vite --config browser.vite.config.ts",
    "build": "electron-vite build",
    "build:browser": "vite build --config browser.vite.config.ts",
    "build:electron": "electron-vite build && electron-builder",
    "preview": "electron-vite preview",
    "preview:browser": "vite preview --config browser.vite.config.ts",
    "postinstall": "electron-builder install-app-deps",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "build:css": "npx @tailwindcss/cli -i app.css -o public/output.css"
  },
  "dependencies": {
    "@microsoft/fetch-event-source": "^2.0.1",
    "@tailwindcss/postcss": "^4.3.2",
    "axios": "^1.7.9",
    "marked": "^18.0.5",
    "pinia": "^2.3.0",
    "qrcode": "^1.5.4",
    "v-viewer": "^3.0.23",
    "vditor": "^3.11.2",
    "viewerjs": "^1.14.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "xgplayer": "^3.0.26",
    "xgplayer-vue": "^1.1.5"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@rushstack/eslint-patch": "^1.10.4",
    "@types/node": "^20.17.11",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.3.0",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.4.20",
    "daisyui": "^5.6.13",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vue-tsc": "^2.2.0"
  }
}
